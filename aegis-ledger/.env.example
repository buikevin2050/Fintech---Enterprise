# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL Ledger Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aegis_ledger
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aegis_ledger
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_STATEMENT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# Concurrency & Lock Policy
PESSIMISTIC_LOCK_TIMEOUT_MS=5000
