{
  "name": "aegis-ledger",
  "version": "1.0.0",
  "description": "Production-grade, enterprise-ready Double-entry Bookkeeping & Financial Ledger Engine",
  "author": "AegisLedger Core Architecture Team",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/main/server.js",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "start": "node dist/main/server.js",
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/main/server.ts",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:unit": "node node_modules/vitest/vitest.mjs run tests/unit",
    "test:integration": "node node_modules/vitest/vitest.mjs run tests/integration",
    "test:concurrency": "node node_modules/vitest/vitest.mjs run tests/concurrency",
    "test:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "migrate": "node node_modules/tsx/dist/cli.mjs src/ledger/infrastructure/database/migrate.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.5.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
